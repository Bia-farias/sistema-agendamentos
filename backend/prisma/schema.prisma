// ==============================================================================
// AGENDA AI — SCHEMA PRISMA ORM (POSTGRESQL)
// Mapeado de acordo com o Frontend (React 18 + TypeScript + Zustand)
// Suporte a Multi-Tenant, ERP Financeiro, Agendamentos e Soft-Delete
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  PROFESSIONAL
  RECEPTIONIST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum TenantPlan {
  FREE_SINGLE
  FREE
  STARTER
  ADVANCE
  PRO
  ENTERPRISE
}

enum BusinessType {
  BARBERSHOP
  BEAUTY_SALON
  AESTHETIC_CLINIC
  HEALTH_CLINIC
  OTHER
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  UNPAID
}

enum ReceivableStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  PARTIALLY_PAID
}

enum PayableStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PayableCategory {
  ALUGUEL
  SALARIOS
  COMISSOES
  FORNECEDORES
  MARKETING
  INTERNET
  ENERGIA
  IMPOSTOS
  MATERIAIS
  FUNCIONARIOS
  OUTROS
}

enum MovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

// ------------------------------------------------------------------------------
// MODELOS PRINCIPAIS
// ------------------------------------------------------------------------------

model Tenant {
  id                 String       @id @default(uuid())
  name               String
  slug               String       @unique
  plan               TenantPlan   @default(PRO)
  businessType       BusinessType @default(BEAUTY_SALON)
  phone              String?
  email              String?
  logoUrl            String?
  address            String?
  openingTime        String       @default("08:00")
  closingTime        String       @default("20:00")
  intervalMinutes    Int          @default(30)
  allowOnlineBooking Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relacionamentos Operacionais
  users         User[]
  clients       Client[]
  professionals Professional[]
  services      Service[]
  appointments  Appointment[]

  // Relacionamentos Financeiros ERP
  receivables    Receivable[]
  payables       Payable[]
  suppliers      Supplier[]
  merchandises   Merchandise[]
  stockMovements StockMovement[]
  depositConfig  DepositConfig?

  // Relacionamentos WhatsApp e IA
  whatsappConnection WhatsAppConnection?
  whatsappLogs       WhatsAppMessageLog[]
  aiConversations    AIConversation[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  password  String // Hash bcrypt
  fullName  String
  role      UserRole @default(OWNER)
  phone     String?
  avatarUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Vínculo opcional se o usuário for um profissional da equipe
  professional Professional?

  // Conversas com IA
  aiConversations AIConversation[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Client {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String
  birthDate DateTime?
  notes     String?
  isVip     Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  appointments Appointment[]
  receivables  Receivable[]

  @@index([tenantId, name])
  @@index([tenantId, phone])
  @@index([tenantId, isActive])
  @@map("clients")
}

model Professional {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId               String?  @unique
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                 String
  email                String?
  phone                String?
  avatarUrl            String?
  role                 String   @default("Especialista")
  specialties          String[] @default([])
  commissionPercentage Decimal  @default(0.00) @db.Decimal(5, 2)
  color                String?  @default("#6366f1")
  isActive             Boolean  @default(true)
  workingHoursStart    String   @default("09:00")
  workingHoursEnd      String   @default("19:00")
  workingDays          Int[]    @default([1, 2, 3, 4, 5, 6]) // 0=Dom, 1=Seg...
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  appointments Appointment[]
  payables     Payable[]

  @@index([tenantId, isActive])
  @@map("professionals")
}

model Service {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  category        String   @default("Geral")
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int      @default(30)
  color           String?  @default("#6366f1")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments Appointment[]

  @@index([tenantId, isActive])
  @@map("services")
}

model Appointment {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professionalId  String
  professional    Professional      @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  date            String // Formato YYYY-MM-DD
  startTime       String // Formato HH:mm
  endTime         String // Formato HH:mm
  durationMinutes Int
  status          AppointmentStatus @default(PENDING)
  paymentMethod   PaymentMethod     @default(UNPAID)
  totalPrice      Decimal           @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  receivables Receivable[]

  @@index([tenantId, date, startTime])
  @@index([professionalId, date])
  @@index([clientId])
  @@map("appointments")
}

// ------------------------------------------------------------------------------
// MODELOS FINANCEIROS (ERP)
// ------------------------------------------------------------------------------

model Receivable {
  id               String           @id @default(uuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId    String?
  appointment      Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  clientId         String?
  client           Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  customerName     String
  customerPhone    String?
  serviceName      String?
  professionalName String?
  description      String
  originalAmount   Decimal          @db.Decimal(10, 2)
  discount         Decimal          @default(0.00) @db.Decimal(10, 2)
  surcharge        Decimal          @default(0.00) @db.Decimal(10, 2)
  finalAmount      Decimal          @db.Decimal(10, 2)
  amountPaid       Decimal          @default(0.00) @db.Decimal(10, 2)
  paymentMethod    PaymentMethod    @default(PIX)
  dueDate          String           // YYYY-MM-DD
  paidAt           String?          // YYYY-MM-DD
  status           ReceivableStatus @default(PENDING)
  hasSignal        Boolean          @default(false)
  signalAmount     Decimal?         @db.Decimal(10, 2)
  signalPaid       Boolean          @default(false)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("financial_receivables")
}

model Payable {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  description      String
  category         PayableCategory @default(OUTROS)
  supplierId       String?
  supplier         Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName     String?
  dueDate          String          // YYYY-MM-DD
  amount           Decimal         @db.Decimal(10, 2)
  paidAmount       Decimal         @default(0.00) @db.Decimal(10, 2)
  status           PayableStatus   @default(PENDING)
  paymentMethod    PaymentMethod?
  paidAt           String?
  professionalId   String?
  professional     Professional?   @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  professionalName String?
  isRecurring      Boolean         @default(false)
  recurrenceType   String?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("financial_payables")
}

model Supplier {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  tradeName   String?
  document    String   // CNPJ / CPF
  phone       String
  email       String?
  address     String?
  carrierName String?
  category    String   @default("Geral")
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payables     Payable[]
  merchandises Merchandise[]

  @@index([tenantId, isActive])
  @@map("financial_suppliers")
}

model Merchandise {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName    String?
  carrierName     String?
  quantity        Int      @default(0)
  minQuantity     Int      @default(5)
  unit            String   @default("un")
  costPrice       Decimal  @db.Decimal(10, 2)
  salePrice       Decimal? @db.Decimal(10, 2)
  totalCost       Decimal  @db.Decimal(10, 2)
  lastRestockDate String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  movements StockMovement[]

  @@index([tenantId, isActive])
  @@map("financial_merchandise")
}

model StockMovement {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  merchandiseId String
  merchandise   Merchandise  @relation(fields: [merchandiseId], references: [id], onDelete: Cascade)
  type          MovementType
  quantityDelta Int
  previousQty   Int
  newQty        Int
  reason        String?
  createdAt     DateTime     @default(now())

  @@index([tenantId, merchandiseId])
  @@map("financial_stock_movements")
}

model DepositConfig {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  type      String   @default("percentage") // "percentage" | "fixed"
  value     Decimal  @default(30.00) @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt

  @@map("financial_deposit_configs")
}

// ------------------------------------------------------------------------------
// MODELOS WHATSAPP E INTELIGÊNCIA ARTIFICIAL
// ------------------------------------------------------------------------------

model WhatsAppConnection {
  id                 String   @id @default(uuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status             String   @default("disconnected") // connected, disconnected, connecting
  phoneNumber        String?
  instanceName       String?  @default("WhatsApp Business")
  batteryLevel       Int?     @default(100)
  lastSyncAt         String?
  totalSentThisMonth Int      @default(0)
  confirmationRate   Decimal  @default(0.00) @db.Decimal(5, 2)
  updatedAt          DateTime @updatedAt

  @@map("whatsapp_connections")
}

model WhatsAppMessageLog {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  appointmentId String?
  templateName  String?
  message       String
  status        String   @default("delivered") // pending, sent, delivered, read, failed
  sentAt        DateTime @default(now())

  @@index([tenantId, customerPhone])
  @@map("whatsapp_message_logs")
}

model AIConversation {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("Nova Conversa")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AIMessage[]

  @@index([tenantId, userId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // user, assistant, system
  content        String
  createdAt      DateTime       @default(now())

  @@map("ai_messages")
}
