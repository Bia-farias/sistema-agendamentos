{
  "name": "agenda-ai-backend",
  "version": "1.0.0",
  "description": "API REST do sistema Agenda AI com Node.js, Express, TypeScript e Prisma ORM",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "tsx src/tests/testPhase1.ts",
    "test:phase1": "tsx src/tests/testPhase1.ts",
    "test:phase2": "tsx src/tests/testPhase2.ts",
    "test:all": "tsx src/tests/testPhase1.ts && tsx src/tests/testPhase2.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "agenda",
    "agendamento",
    "api",
    "express",
    "prisma",
    "typescript",
    "multi-tenant"
  ],
  "author": "Agenda AI Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.5",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.20.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
